#!/bin/sh

RumiAI_lang_validate()
{
  [ "$#" -eq 1 ] || return 1

  [ -n "$1" ] && case "$1" in [a-z][a-z]_[A-Z][A-Z]) : ;; *) false;; esac && [ -d "$RumiAI_LANG_DIR/$1" ]
}

RumiAI_lang_normalize()
{
  [ "$#" -eq 1 ] || return 1

  set -- "${1%%.*}"
  set -- "${1%%@*}"

  [ "$1" != "${1%%_*}" ] && printf '%s' "$(printf '%s' "${1%%_*}" | tr 'A-Z' 'a-z')_$(printf '%s' "${1#*_}" | tr 'a-z' 'A-Z')"
}

RumiAI_lang_init()
{
  # conf files
  RumiAI_CONF_FILE_LANG_LANGUAGE=$RumiAI_CONF_DIR/lang/language
  RumiAI_CONF_FILE_LANG_TEXT_ENCODING=$RumiAI_CONF_DIR/lang/text-encoding

  # set var - language
  RumiAI_LANGUAGE_FALLBACK=en_US

  if ! RumiAI_LANGUAGE="$(command -p -- cat "$RumiAI_CONF_FILE_LANG_LANGUAGE" 2>/dev/null)" || ! RumiAI_lang_validate "$RumiAI_LANGUAGE"
  then
    printf -- '%s\n' 'RumiAI_BOOTSTRAP_ERROR_LANG_LANGUAGE_LOAD_ERROR' >&2

    RumiAI_LANGUAGE="$(RumiAI_lang_normalize "${LC_ALL%%.*}")" && RumiAI_lang_validate "$RumiAI_LANGUAGE"
    if [ "$?" != 0 ]
    then
      RumiAI_LANGUAGE="$(RumiAI_lang_normalize "${LC_MESSAGES%%.*}")" && RumiAI_lang_validate "$RumiAI_LANGUAGE"
      if [ "$?" != 0 ]
      then
        RumiAI_LANGUAGE="$(RumiAI_lang_normalize "${LANG%%.*}")" && RumiAI_lang_validate "$RumiAI_LANGUAGE"
        [ "$?" != 0 ] && RumiAI_LANGUAGE="$RumiAI_LANGUAGE_FALLBACK"
      fi
    fi
  fi

  # set var - text encoding
  if ! RumiAI_TEXT_ENCODING="$(command -p -- cat "$RumiAI_CONF_FILE_LANG_TEXT_ENCODING" 2>/dev/null)"
  then
    printf -- '%s\n' 'RumiAI_BOOTSTRAP_ERROR_LANG_TEXT_ENCODING_LOAD_ERROR' >&2
    RumiAI_TEXT_ENCODING=UTF-8
  fi

  # supported encodings
  case $RumiAI_TEXT_ENCODING in
    UTF-8 | utf-8)
      RumiAI_TEXT_ENCODING=UTF-8
      ;;
    *)
      RumiAI_TEXT_ENCODING=UTF-8
      ;;
  esac

  # unset variables
  unset -v -- RumiAI_CONF_FILE_LANG_LANGUAGE RumiAI_CONF_FILE_LANG_TEXT_ENCODING
}

lang()
(
  [ "$#" -eq 2 ] || return 1

  RumiAI_lang_domain=$1
  RumiAI_lang_message_id=$2

  case "$RumiAI_LANGUAGE" in [a-z][a-z]_[A-Z][A-Z]) true;; *) false;; esac && RumiAI_text_safe_id "$RumiAI_lang_domain" && RumiAI_text_safe_id "$RumiAI_lang_message_id" || return 2

  RumiAI_lang_message="$(command -p -- cat "$RumiAI_LANG_DIR/$RumiAI_LANGUAGE/$RumiAI_lang_domain/$RumiAI_lang_message_id" 2>/dev/null)"
  if [ "$?" != 0 ]
  then
    [ "$RumiAI_LANGUAGE" != "$RumiAI_LANGUAGE_FALLBACK" ] && case "$RumiAI_LANGUAGE_FALLBACK" in [a-z][a-z]_[A-Z][A-Z]) true;; *) false;; esac && RumiAI_lang_message="$(command -p -- cat "$RumiAI_LANG_DIR/$RumiAI_LANGUAGE_FALLBACK/$RumiAI_lang_domain/$RumiAI_lang_message_id" 2>/dev/null)"
    if [ "$?" != 0 ]
    then
      RumiAI_lang_message="${RumiAI_lang_domain}.${RumiAI_lang_message_id}"
    fi
  fi

  printf -- '%s\n' "$RumiAI_lang_message"
)
