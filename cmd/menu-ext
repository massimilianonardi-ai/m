#!/bin/sh

# menu-ext: small terminal menu with a POSIX-sh implementation.
#
# Usage:
#   menu-ext [-H header] [-F footer] [-B bottom-footer] -- item ...
#
# Each item is either:
#   text
#   value@:=text
#
# The selected value is written to standard output.  The terminal UI is
# written directly to /dev/tty, so command substitution remains usable.

header=""
footer=""
bottom_footer=""
tty_active="0"
alt_screen="0"
cursor_hidden="0"
saved_tty=""

usage()
{
  printf '%s\n' \
    'usage: menu-ext [-H header] [-F footer] [-B bottom-footer] -- item ...' \
    '' \
    'options:' \
    '  -H text        header at the top of the screen' \
    '  -F text        footer immediately after the last visible item' \
    '  -B text        footer anchored at the bottom of the screen' \
    '' \
    'item forms:' \
    '  text           display and return text' \
    '  value@:=text   display text and return value' \
    '' \
    'keys:' \
    '  Up/Down, k/j   move' \
    '  PageUp/PageDown move by one page' \
    '  Enter          select' \
    '  q, Esc         cancel'
}

cleanup()
{
  if [ "$tty_active" = "1" ]
  then
    stty "$saved_tty" <&3 2>/dev/null || :
    tput sgr0 >&3 2>/dev/null || :

    if [ "$alt_screen" = "1" ]
    then
      tput rmcup >&3 2>/dev/null || :
    fi

    if [ "$cursor_hidden" = "1" ]
    then
      tput cnorm >&3 2>/dev/null || :
    fi

    tty_active="0"
  fi
}

fail()
{
  cleanup
  printf 'menu-ext: %s\n' "$1" >&2
  exit 2
}

split_item()
{
  case "$1" in
    *@:=*)
      item_value="${1%%@:=*}"
      item_text="${1#*@:=}"
      ;;
    *)
      item_value="$1"
      item_text="$1"
      ;;
  esac
}

line_count()
{
  if [ -z "$1" ]
  then
    printf '%s\n' '0'
  else
    printf '%s\n' "$1" | awk 'END { print NR }'
  fi
}

print_block()
{
  printf '%s\n' "$1" |
    awk -v width="$2" -v trailing_newline="$3" '
      NR > 1 { printf "\n" }
      { printf "%s", substr($0, 1, width) }
      END {
        if (trailing_newline == "1") {
          printf "\n"
        }
      }
    ' >&3
}

read_byte()
{
  byte="$(dd bs=1 count=1 <&3 2>/dev/null | od -A n -t u1 | tr -d '[:space:]')"
  [ -n "$byte" ]
}

read_byte_timed()
{
  stty min 0 time 2 <&3 2>/dev/null || return 1
  byte="$(dd bs=1 count=1 <&3 2>/dev/null | od -A n -t u1 | tr -d '[:space:]')"
  stty min 1 time 0 <&3 2>/dev/null || return 1
  [ -n "$byte" ]
}

read_csi_key()
{
  csi_parameter=""

  while :
  do
    if [ "$byte" -ge 64 ] && [ "$byte" -le 126 ]
    then
      case "$byte" in
        65)
          key="up"
          ;;
        66)
          key="down"
          ;;
        126)
          case "$csi_parameter" in
            5) key="pageup" ;;
            6) key="pagedown" ;;
            *)  key="other" ;;
          esac
          ;;
        *)
          key="other"
          ;;
      esac

      return 0
    fi

    case "$byte" in
      48) csi_parameter="${csi_parameter}0" ;;
      49) csi_parameter="${csi_parameter}1" ;;
      50) csi_parameter="${csi_parameter}2" ;;
      51) csi_parameter="${csi_parameter}3" ;;
      52) csi_parameter="${csi_parameter}4" ;;
      53) csi_parameter="${csi_parameter}5" ;;
      54) csi_parameter="${csi_parameter}6" ;;
      55) csi_parameter="${csi_parameter}7" ;;
      56) csi_parameter="${csi_parameter}8" ;;
      57) csi_parameter="${csi_parameter}9" ;;
      59) csi_parameter="${csi_parameter};" ;;
    esac

    if ! read_byte_timed
    then
      key="escape"
      return 0
    fi
  done
}

read_key_from_byte()
{
  key=""

  case "$byte" in
    10|13)
      key="enter"
      ;;
    27)
      if ! read_byte_timed
      then
        key="escape"
        return 0
      fi

      case "$byte" in
        91)
          if ! read_byte_timed
          then
            key="escape"
            return 0
          fi

          read_csi_key
          ;;
        79)
          if ! read_byte_timed
          then
            key="escape"
            return 0
          fi

          case "$byte" in
            65) key="up" ;;
            66) key="down" ;;
            *)  key="other" ;;
          esac
          ;;
        *)
          key="escape"
          ;;
      esac
      ;;
    106)
      key="down"
      ;;
    107)
      key="up"
      ;;
    113)
      key="quit"
      ;;
    *)
      key="other"
      ;;
  esac

  return 0
}

read_key()
{
  if ! read_byte
  then
    return 1
  fi

  read_key_from_byte
}

read_key_nowait()
{
  stty min 0 time 0 <&3 2>/dev/null || return 1
  read_byte
  status="$?"
  stty min 1 time 0 <&3 2>/dev/null || return 1

  if [ "$status" -ne 0 ]
  then
    return 1
  fi

  read_key_from_byte
}

update_geometry()
{
  term_lines="$(tput lines 2>/dev/null)" || fail 'cannot read terminal height'
  term_cols="$(tput cols 2>/dev/null)" || fail 'cannot read terminal width'

  case "$term_lines" in
    ''|*[!0-9]*) fail 'invalid terminal height' ;;
  esac

  case "$term_cols" in
    ''|*[!0-9]*) fail 'invalid terminal width' ;;
  esac

  header_lines="$(line_count "$header")"
  footer_lines="$(line_count "$footer")"
  bottom_footer_lines="$(line_count "$bottom_footer")"
  visible_rows="$((term_lines - header_lines - footer_lines - bottom_footer_lines))"

  if [ "$visible_rows" -lt 1 ] || [ "$term_cols" -lt 3 ]
  then
    fail 'terminal is too small'
  fi
}

render_menu()
{
  selected="$1"
  top="$2"
  shift 2

  tput clear >&3 2>/dev/null || fail 'terminal does not support clear'

  if [ -n "$header" ]
  then
    print_block "$header" "$term_cols" "1"
  fi

  remaining="$((item_count - top))"
  if [ "$remaining" -lt "$visible_rows" ]
  then
    render_rows="$remaining"
  else
    render_rows="$visible_rows"
  fi

  index="0"
  row="0"
  last_menu_row="$((render_rows - 1))"
  text_width="$((term_cols - 2))"

  for item
  do
    if [ "$index" -ge "$top" ] && [ "$row" -lt "$render_rows" ]
    then
      split_item "$item"
      text="$(printf '%s\n' "$item_text" | cut -c "1-$text_width")"

      if [ "$index" -eq "$selected" ]
      then
        tput rev >&3 2>/dev/null || :
        printf '> %s' "$text" >&3
        tput sgr0 >&3 2>/dev/null || :
      else
        printf '  %s' "$text" >&3
      fi

      if [ "$row" -lt "$last_menu_row" ] || [ -n "$footer" ]
      then
        printf '\n' >&3
      fi

      row="$((row + 1))"
    fi

    index="$((index + 1))"
  done

  if [ -n "$footer" ]
  then
    print_block "$footer" "$term_cols" "0"
  fi

  if [ -n "$bottom_footer" ]
  then
    bottom_footer_row="$((term_lines - bottom_footer_lines))"
    tput cup "$bottom_footer_row" 0 >&3 2>/dev/null || fail 'terminal does not support cursor positioning'
    print_block "$bottom_footer" "$term_cols" "0"
  fi

  tput cup 0 0 >&3 2>/dev/null || fail 'terminal does not support cursor positioning'
}

selected_value()
{
  wanted="$1"
  shift
  index="0"

  for item
  do
    if [ "$index" -eq "$wanted" ]
    then
      split_item "$item"
      printf '%s\n' "$item_value"
      return 0
    fi

    index="$((index + 1))"
  done

  return 1
}

apply_key()
{
  action=""

  case "$key" in
    up)
      if [ "$selected" -gt 0 ]
      then
        selected="$((selected - 1))"
        action="move"
      fi
      ;;
    down)
      if [ "$selected" -lt "$((item_count - 1))" ]
      then
        selected="$((selected + 1))"
        action="move"
      fi
      ;;
    pageup)
      page_step="$((visible_rows - 1))"
      if [ "$page_step" -lt 1 ]
      then
        page_step="1"
      fi

      if [ "$selected" -gt 0 ]
      then
        selected="$((selected - page_step))"
        if [ "$selected" -lt 0 ]
        then
          selected="0"
        fi
        action="move"
      fi
      ;;
    pagedown)
      page_step="$((visible_rows - 1))"
      if [ "$page_step" -lt 1 ]
      then
        page_step="1"
      fi

      if [ "$selected" -lt "$((item_count - 1))" ]
      then
        selected="$((selected + page_step))"
        if [ "$selected" -gt "$((item_count - 1))" ]
        then
          selected="$((item_count - 1))"
        fi
        action="move"
      fi
      ;;
    enter)
      action="select"
      ;;
    quit|escape)
      action="cancel"
      ;;
  esac
}

while getopts ':H:F:B:h' option
do
  case "$option" in
    H)
      header="$OPTARG"
      ;;
    F)
      footer="$OPTARG"
      ;;
    B)
      bottom_footer="$OPTARG"
      ;;
    h)
      usage
      exit 0
      ;;
    :)
      fail "option -$OPTARG requires an argument"
      ;;
    \?)
      fail "unknown option: -$OPTARG"
      ;;
  esac
done

delimiter_index="$((OPTIND - 1))"
index="1"
delimiter_seen="0"
for argument
do
  if [ "$index" -eq "$delimiter_index" ]
  then
    if [ "$argument" = "--" ]
    then
      delimiter_seen="1"
    fi
    break
  fi

  index="$((index + 1))"
done

shift "$delimiter_index"

if [ "${delimiter_seen:-0}" != "1" ]
then
  fail 'missing -- before menu items'
fi

if [ "$#" -eq 0 ]
then
  fail 'at least one menu item is required'
fi

newline='
'
for item
do
  split_item "$item"
  case "$item_text" in
    *"$newline"*) fail 'menu item text must be a single line' ;;
  esac
done

if ! command -v tput >/dev/null 2>&1
then
  fail 'tput is required'
fi

if ! exec 3<>/dev/tty
then
  fail 'no controlling terminal is available'
fi

saved_tty="$(stty -g <&3 2>/dev/null)" || fail 'cannot read terminal settings'
tty_active="1"
trap 'cleanup' 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 131' QUIT
trap 'exit 143' TERM
trap 'exit 148' TSTP

stty -echo -icanon min 1 time 0 <&3 2>/dev/null || fail 'cannot configure terminal'

if tput smcup >&3 2>/dev/null
then
  alt_screen="1"
fi

if tput civis >&3 2>/dev/null
then
  cursor_hidden="1"
fi

item_count="$#"
selected="0"
top="0"
render_needed="1"

while :
do
  if [ "$render_needed" = "1" ]
  then
    update_geometry

    if [ "$selected" -lt "$top" ]
    then
      top="$selected"
    elif [ "$selected" -ge "$((top + visible_rows))" ]
    then
      top="$((selected - visible_rows + 1))"
    fi

    render_menu "$selected" "$top" "$@"
    render_needed="0"
  fi

  if ! read_key
  then
    fail 'cannot read from terminal'
  fi

  apply_key

  case "$action" in
    select)
      cleanup
      selected_value "$selected" "$@" || fail 'cannot resolve selection'
      exit 0
      ;;
    cancel)
      cleanup
      exit 1
      ;;
    move)
      pending="0"
      while [ "$pending" -lt 64 ] && read_key_nowait
      do
        apply_key

        case "$action" in
          select)
            cleanup
            selected_value "$selected" "$@" || fail 'cannot resolve selection'
            exit 0
            ;;
          cancel)
            cleanup
            exit 1
            ;;
        esac

        pending="$((pending + 1))"
      done

      render_needed="1"
      ;;
  esac
done
