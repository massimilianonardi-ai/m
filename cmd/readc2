#!/bin/sh

. term.lib.sh

keypad_enabled=false

cleanup()
{
  status=$?

  trap - 0 HUP INT QUIT TERM PIPE TSTP

  if [ "$keypad_enabled" = "true" ]
  then
    term_keypad_disable >/dev/null 2>&1 || :
  fi

  if [ "${term_tty_saved-}" = "true" ]
  then
    term_tty_restore >/dev/null 2>&1 || :
  fi

  exit "$status"
}

term_tty_save || {
  printf '%s\n' 'readc: no controlling terminal' >&2
  exit 1
}

trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 131' QUIT
trap 'exit 143' TERM
trap 'exit 141' PIPE
trap 'exit 148' TSTP

if ! command -v tput >/dev/null 2>&1 ||
   [ -z "${TERM-}" ] ||
   [ "$TERM" = "dumb" ] ||
   ! tput cols >/dev/null 2>&1
then
  printf '%s\n' 'readc: TERM/terminfo unavailable' >&2
  exit 1
fi

term_tty_blocking || exit 1
term_keymap_init || exit 1

if term_keypad_enable
then
  keypad_enabled=true
fi

term_read_key
status=$?

case "$status" in
  0)
    ;;
  3)
    printf '%s\n' 'readc: no input available' >&2
    exit 1
    ;;
  *)
    printf '%s\n' 'readc: cannot read terminal input' >&2
    exit 1
    ;;
esac

case "$term_key" in
  text)
    printf '%s\n' "$term_key_text"
    ;;
  unknown)
    printf 'readc: unknown terminal sequence: %s\n' "$term_key_hex" >&2
    exit 2
    ;;
  control)
    printf 'readc: unsupported input byte: %s\n' "$term_key_hex" >&2
    exit 2
    ;;
  *)
    printf '%s\n' "$term_key"
    ;;
esac
